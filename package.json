{
  "name": "appcenterv2",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "ts-node scripts/e2e-simulation-test.ts",
    "test:e2e": "ts-node scripts/e2e-simulation-test.ts",
    "test:simulation": "ts-node scripts/e2e-simulation-test.ts",
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev:server": "nodemon src/server.ts",
    "dev:client": "pnpm --filter appcenter-client run dev",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "lint": "eslint \"src/**/*.{ts,js}\" --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "prepare": "husky install || true",
    "build:client": "cd client && pnpm run build",
    "build": "node scripts/build.js",
    "zip": "node scripts/zip.js",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "backupdb:scheme": "node scripts/backup-schema.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@types/express-mysql-session": "^3.0.8",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.13.2",
    "basic-ftp": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "mysql2": "^3.16.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.2",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^6.4.17",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
