# Environment configuration template for AppCenter V2
DATABASE_URL="mysql://root:password@localhost:3306/appcenter?connect_timeout=60&pool_timeout=60&connection_limit=5"
PORT=4829
NODE_ENV="development"
SESSION_SECRET="your-super-secret-session-key-change-in-production"

# Xendit Payment Gateway (Sandbox/Production)
XENDIT_SECRET_KEY="xnd_development_sample_secret_key"
XENDIT_PUBLIC_KEY="xnd_development_sample_public_key"
XENDIT_WEBHOOK_TOKEN="sample_webhook_token_123"
XENDIT_CALLBACK_URL="http://localhost:4829/payment/success"

# Payment Settings
PAYMENT_ADMIN_FEE_PERCENT=0
PAYMENT_EXPIRY_HOURS=24

# SMTP Mail Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="mailer@example.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM_EMAIL="mailer@example.com"
SMTP_FROM_NAME="AppCenter - Digital Marketplace"
SMTP_ENCRYPTION="ssl"
SMTP_SECURE="true"
SMTP_IS_ACTIVE="true"

# SFTP Storage (Remote Installer Binaries)
SFTP_HOST="127.0.0.1"
SFTP_PORT=22
SFTP_USERNAME="sftp-user"
SFTP_PASSWORD="your_sftp_password"
SFTP_BASE_DIR="/var/www/html/setup-windows-bin/x86"
SFTP_PUBLIC_URL="https://download.example.com"
